# Copy to .lab.env and fill in. .lab.env is git-ignored — never commit it.
LAB_SSH_HOST=10.1.75.79
LAB_SSH_USER=student
LAB_SSH_PASSWORD=changeme
LAB_DB_PASSWORD=changeme
# Shared cluster secret: the AES-GCM data key and every user's Ed25519 signing
# key are derived from this, so it must be identical on all backend nodes.
LAB_CHAT_SECRET=changeme-cluster-secret
